// Tell benchmark case L09-secret-returned: a secret returned from an exported circuit
// SPDX-License-Identifier: Apache-2.0
//
// truth: leak
// class: secret-published
// circuit: recoveryCode
// line: 20
// why: an exported circuit's result is part of the public transaction, so the returned recovery code is public.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger lookups: Counter;

witness recoverySecret(): Bytes<32>;

export circuit recoveryCode(): Bytes<32> {
  lookups.increment(1);
  return disclose(recoverySecret()); // LEAK
}
