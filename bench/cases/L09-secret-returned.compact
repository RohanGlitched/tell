// Tell benchmark case L09-secret-returned: a secret returned from an exported circuit
// SPDX-License-Identifier: Apache-2.0
//
// truth: not-public
// class: secret-returned
// circuit: recoveryCode
// line: none
// why: relabelled Nov 7, 2026. The case assumed an exported circuit's result is public; it is not on chain. A ledger ContractCall carries the address, entry point, transcripts, proof and a communication commitment, a randomized commitment to the call's inputs and outputs, so the code goes to the DApp (or a calling contract), not to the network. Reporting it is a correct observation of a value leaving the proof, not a public leak.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger lookups: Counter;

witness recoverySecret(): Bytes<32>;

export circuit recoveryCode(): Bytes<32> {
  lookups.increment(1);
  return disclose(recoverySecret()); // LEAK
}
