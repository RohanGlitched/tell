pragma language_version 0.23;

import CompactStandardLibrary;

export ledger consents: Map<Bytes<32>, Bytes<32>>;

witness agrees(): Boolean;

export circuit consent(form: Bytes<32>): [] {
  consents.insert(disclose(form), disclose(persistentHash<Boolean>(agrees()))); // LEAK
}
