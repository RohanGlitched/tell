pragma language_version 0.23;
import CompactStandardLibrary;
// Names with "secret" in them that are not secrets (from Nightshade's corpus), and one that is.
export ledger ownerCommitment: Bytes<32>;
export ledger ownerTag: Bytes<32>;
export ledger leaked: Bytes<32>;
witness secretHash(): Bytes<32>;
witness secretKey(): Bytes<32>;

constructor(secretCommitment: Bytes<32>) {
  ownerCommitment = disclose(secretCommitment);
}

export circuit setTag(): [] {
  ownerTag = disclose(secretHash());
}

export circuit leak(): [] {
  leaked = disclose(secretKey());
}
