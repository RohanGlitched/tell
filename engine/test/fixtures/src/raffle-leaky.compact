// Tell leak zoo: a guessable hash written by the constructor.
// Copyright (C) 2026 Rohan Borade
// SPDX-License-Identifier: Apache-2.0
//
// The organiser seals the winning number at deploy time and opens it after
// the draw closes. The seal is hash(number), and the number is one of 10,000
// tickets, so anyone who reads the contract's initial state can hash every
// ticket and know the winner before a single ticket is sold.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger sealedDraw: Bytes<32>;
export ledger drawn: Uint<16>;
export ledger open: Boolean;

witness winningNumber(): Uint<16>;

export pure circuit seal(n: Uint<16>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "raffle:seal"), (n as Field) as Bytes<32>]);
}

constructor() {
  const n = winningNumber();
  assert(n < 10000, "tickets run from 0 to 9999");
  sealedDraw = disclose(seal(n));
  open = false;
}

export circuit reveal(n: Uint<16>): [] {
  assert(!open, "already drawn");
  assert(seal(n) == sealedDraw, "that is not the sealed number");
  drawn = disclose(n);
  open = true;
}
