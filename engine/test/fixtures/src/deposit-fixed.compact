// Tell leak zoo: the sealed bid deposit, fixed.
// Copyright (C) 2026 Rohan Borade
// SPDX-License-Identifier: Apache-2.0
//
// Every bidder locks the same public bond, the auction's ceiling, whatever
// they bid. The bid itself stays in the salted commitment; the deposits are
// identical, so they say nothing about it. The difference is refunded after
// the bids are opened.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger bids: Map<Bytes<32>, Bytes<32>>;
export sealed ledger ceiling: Uint<64>;

witness bidderKey(): Bytes<32>;
witness bidAmount(): Uint<64>;
witness bidSalt(): Bytes<32>;

constructor(maxBid: Uint<64>) {
  ceiling = disclose(maxBid);
}

export pure circuit bidderTag(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "deposit:bidder"), sk]);
}

export circuit bid(): [] {
  const tag = disclose(bidderTag(bidderKey()));
  assert(!bids.member(tag), "one bid per bidder");
  const amount = bidAmount();
  assert(amount <= ceiling, "bid above the ceiling");
  bids.insert(tag, disclose(persistentCommit<Uint<64>>(amount, bidSalt())));
  receiveUnshielded(nativeToken(), ceiling as Uint<128>);
}
