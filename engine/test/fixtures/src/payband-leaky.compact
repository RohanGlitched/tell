// Tell leak zoo: a guessable hash over an amount.
// Copyright (C) 2026 Rohan Borade
// SPDX-License-Identifier: Apache-2.0
//
// Employees file a "private" salary record so they can later prove it to a
// lender. The record is hash(employee id, salary). The employee id is public
// and a monthly salary in rupees fits in 24 bits, so the salary falls to a
// brute force of about sixteen million hashes.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger employer: Bytes<32>;
export ledger records: Map<Uint<32>, Bytes<32>>;

witness employerKey(): Bytes<32>;
witness salary(): Uint<32>;

constructor(owner: Bytes<32>) {
  employer = disclose(owner);
}

export pure circuit keyHash(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "payband:employer"), sk]);
}

export pure circuit recordOf(employee: Uint<32>, pay: Uint<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "payband:record"), (employee as Field) as Bytes<32>, (pay as Field) as Bytes<32>]);
}

export circuit file(employee: Uint<32>): [] {
  assert(keyHash(employerKey()) == employer, "only the employer files records");
  const pay = salary();
  assert(pay > 0, "salary must be positive");
  records.insert(disclose(employee), disclose(recordOf(employee, pay)));
}
